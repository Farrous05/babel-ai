# Azure OpenAI

AZURE_ENDPOINT=https://some-endpoint.openai.azure.com/
AZURE_KEY=AZURE_OPENAI_API_KEY
AZURE_VERSION="yyyy-mm-dd-option"

# Ollama (local)

OLLAMA_API_BASE=http://localhost:11434

# Company Ollama / vLLM endpoint (OpenAI-compatible). Base URL must include
# the /v1/ suffix. Pull the model on the endpoint before first use.

OLLAMA_COMPANY_BASE_URL=https://your-endpoint-url/v1/
OLLAMA_COMPANY_API_KEY=your-endpoint-api-key

# OpenAI

OPENAI_API_KEY=OPENAI_API_KEY

# Anthropic

ANTHROPIC_API_KEY=ANTHROPIC_API_KEY
